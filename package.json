{
  "name": "scwork-inkjet-sticker-storefront",
  "private": true,
  "version": "1.7.5",
  "description": "SCWORK storefront, unified quote and LINE advice flow",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "check": "node qa/validate-scwork.mjs",
    "check:v25": "node qa/validate-v25.mjs",
    "check:v253": "node qa/validate-v253.mjs",
    "check:legacy": "node qa/validate.mjs && node qa/validate-v21.mjs && node qa/validate-v22.mjs && node qa/validate-v23.mjs && node qa/validate-v24.mjs && node qa/validate-v25.mjs",
    "check:v254": "node qa/validate-v254.mjs",
    "check:v255": "node qa/validate-v255.mjs",
    "check:v256": "node qa/validate-v256.mjs && node qa/validate-v257.mjs",
    "check:pricing": "node qa/validate-pricing-v11.mjs",
    "check:locales": "node qa/validate-locales-v12.mjs",
    "check:brand": "node qa/validate-brand-v14.mjs",
    "check:cta": "node qa/validate-cta-v141.mjs",
    "check:smart-quote": "node qa/validate-smart-quote-v151.mjs",
    "check:v17": "node qa/validate-v17.mjs",
    "build:public": "node qa/build-public-v174.mjs",
    "check:v174": "node qa/validate-v174.mjs && node qa/validate-v174-quote-ui.mjs",
    "check:v175": "node qa/validate-v175.mjs && node qa/validate-v175-workbench.mjs"
  },
  "license": "UNLICENSED"
}
